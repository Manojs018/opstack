{
	"info": {
		"_postman_id": "erp-crm-api-collection-v1",
		"name": "Mini ERP + CRM API Collection",
		"description": "Comprehensive Postman collection for Mini ERP + CRM Backend API. Includes authentication pre-request scripts, sample request payloads, query parameters, and endpoints for Auth, Dashboard, Customers, Products, Sales Challans, Invoices, Purchase Orders, Stock Movements, and CRM Follow-ups.",
